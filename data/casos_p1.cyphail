// Proyecto Cyphail - Grupo 01-3pm
// Casos de prueba del Sprint P1 (EIF400-II-2026-SPEC-Sprint-P1-Casos de Prueba-CLoria.md)
// "Todo P1 debe funcionar" (Guia de Revision P2). Uso desde el repl:  .load "data/casos_p1.cyphail"
// Grafo p1 = los datos de los JSON de P1 (prolog/graphs/p1.pl).
// Los casos con CREATE / DELETE (7, 9, 11, 12) se muestran con .tree: en P2 solo se ejecutan MATCH, WHERE y RETURN.
.use p1;

// CASO 1 Un patron y proyeccion con un alias
MATCH (m:Movie)
RETURN m.title,
       m.year AS year;

// CASO 2 Un patron, where y proyeccion con un alias. Comparacion
MATCH (b:Book)
WHERE b.pages < 300
RETURN b.title,
       b.pages AS totalPages;

// CASO 3 Un patron con etiquetas multiples
MATCH (a:Person:Employee {id: 1})
WHERE a.age > 30
RETURN a.name AS name,
       a.age AS age;

// CASO 4 Doble patron (desconectados), proyecciones con aliases
MATCH (m:Movie), (p:Person)
WHERE m.year > 2000
RETURN m.title AS title,
       p.name AS actor;

// CASO 5 Doble patron atributos distintos
MATCH (m:Movie), (p:Person)
WHERE m.year <> p.age
RETURN m.title AS title,
       p.name AS name;

// CASO 6 Doble patron c/u con atributo
MATCH (m:Movie {year: 1999}), (p:Person {age: 40})
WHERE m.year <> p.age
RETURN m.title AS title,
       p.name AS name;

// CASO 7 Match un patron y create (solo arbol)
.tree MATCH (p:Person)
WHERE p.age > 18
CREATE (c:Certificate {issuedTo: "adult", year: 2026})
RETURN p.name AS name,
       p.age AS age;

// CASO 8 Match con patron de property expresion simple
MATCH (p:Person {id: 1}), (o:Order {personId: p.id})
RETURN p.name AS name,
       o.total AS total;

// CASO 9 Match create delete (solo arbol)
.tree MATCH (p:Person), (o:Order {personId: p.id, status: "cancelled"})
WHERE p.age > 60
CREATE (a:Archive {id: o.id, name: "retired", year: 2026})
DELETE o
RETURN p.name AS name;

// CASO 10 Deteccion de variables no definidas (arbol + error)
.tree MATCH (p:Person), (o:Order {personId: p.id, status: "cancelled"})
WHERE q.age > 60
RETURN q AS name;

// CASO 11 Orden invertido variables no definidas (arbol + error)
.tree MATCH (o:Order {personId: p.id, status: "cancelled"}), (p:Person)
WHERE p.age > 60
CREATE (a:Archive {id: o.id, name: "retired", year: 2026})
DELETE o
RETURN p.name AS name;

// CASO 12 Variable no definida en RETURN (arbol + error)
.tree MATCH (c:Client:VIP {status: "active"})
WHERE c.rating >= 90
CREATE (b:Badge:Gold {clientId: c.id, level: "elite", year: 2026})
DELETE c
RETURN x.unknown AS val;
