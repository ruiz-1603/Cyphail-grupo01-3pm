// Proyecto Cyphail - Grupo 01-3pm
// Autores: Priscilla Murillo Romero, Aaron Ruiz Medina, Samael Sanchez Mora,
//          Daniel Villarroel Abaduca, Nicolas Zarate Hernandez
// Casos de referencia Sprint P2 (EIF400-II-2026-Cypahil-P2-10-Casos_Prueba_Unitarios.md)
// Uso desde el repl:  .load "data/casos_p2.cyphail"
// Numeracion de la Guia de Revision P2 (C0 a C12). Todos los casos se ejecutan.
// Los casos 7, 8, 9, 11 y 12 cambian el grafo (CREATE / DELETE / SET / REMOVE): despues de cada uno
// hay un MATCH que muestra el cambio y un .use que vuelve a cargar el grafo desde su archivo,
// asi los casos siguientes siempre ven los mismos datos.
.use empresa;

// CASO 1: -[var]-> sin tipo, RETURN de la relacion (su id)
MATCH (p:Persona)-[r]->(q:Persona)
RETURN r;

// CASO 2: tipo de relacion sin variable
MATCH (a:Persona)-[:CONOCE]->(b:Persona)
RETURN a.nombre, b.nombre;

// CASO 3: direccion inversa <-
MATCH (e:Empresa)<-[r:TRABAJA_EN]-(p:Persona)
RETURN p.nombre, e.nombre;

// CASO 3b: sin direccion -
MATCH (a:Persona)-[r:CONOCE]-(b:Persona)
RETURN a.nombre, b.nombre;

// CASO 4: propiedades inline en la relacion y r.prop en RETURN
MATCH (a:Persona)-[r:CONOCE {desde: 2015}]->(b:Persona)
RETURN a.nombre, b.nombre, r.desde;

// CASO 5: WHERE sobre relacion y nodo con AND
MATCH (a:Persona)-[r:CONOCE]->(b:Persona)
WHERE r.desde > 2010 AND b.edad >= 30
RETURN a.nombre, b.nombre, r.desde;

// CASO 6: propiedades inline + WHERE con OR / NOT
MATCH (p:Persona)-[t:TRABAJA_EN {cargo: 'Dev'}]->(e:Empresa)
WHERE t.desde >= 2018 OR NOT e.pais = 'CR'
RETURN p.nombre, e.nombre, t.cargo, t.desde;

// CASO 7: MATCH de dos nodos + CREATE de una relacion entre ellos (reutiliza a y b, no crea nodos)
// Ajustado al grafo empresa (Guia P2: "su caso se ajusta al grafo disponible"): Ana y Luis no estan, Marta y Pedro si
MATCH (a:Persona {nombre: 'Marta'}), (b:Persona {nombre: 'Pedro'})
CREATE (a)-[:CONOCE {desde: 2020, nivel: 'amigo'}]->(b);

MATCH (a:Persona)-[r:CONOCE]->(b:Persona {nombre: 'Pedro'})
RETURN a.nombre, b.nombre, r.desde, r.nivel;

.use empresa;

// CASO 8: CREATE sin MATCH, crea dos nodos y la relacion; RETURN de los ids nuevos
CREATE (a:Persona {nombre: 'Marta'})-[r:TRABAJA_EN {cargo: 'Dev', activo: true}]->(e:Empresa {nombre: 'Acme'})
RETURN a, r, e;

MATCH (p:Persona)-[t:TRABAJA_EN {activo: true}]->(e:Empresa)
RETURN p.nombre, t.cargo, e.nombre;

.use empresa;

// CASO 9: DELETE de una relacion con WHERE (Lucia CONOCE Marta desde 1998); los nodos no cambian
MATCH (a:Persona)-[r:CONOCE]->(b:Persona)
WHERE r.desde < 2000
DELETE r;

MATCH (a:Persona)-[r:CONOCE]->(b:Persona)
RETURN a.nombre, b.nombre, r.desde;

.use empresa;

// CASO 10: integrador
MATCH (p:Persona {activo: true})-[t:TRABAJA_EN {cargo: 'Dev'}]->(e:Empresa),
      (q:Persona)-[s:SOCIO_DE]->(e),
      (p)-[k:CONOCE]-(q)
WHERE (t.desde >= 2018 OR s.porcentaje > 25.5) AND NOT k.desde = 2020
RETURN p.nombre, q.nombre, e.nombre, t.cargo, s.porcentaje, k.desde;

// CASO 8b: dos patrones que comparten e
MATCH (p:Persona)-[:TRABAJA_EN]->(e:Empresa),
      (c:Persona)-[:TRABAJA_EN]->(e)
WHERE p.nombre <> c.nombre
RETURN p.nombre, c.nombre, e.nombre;

// CASO 8c: patrones desconectados (producto cartesiano, una relacion no se usa dos veces)
MATCH (a)-[r]->(b), (c)-[s]->(d)
RETURN r, s;

// CASOS 11 y 12 (Guia P2): usan el grafo revision (Student, Course, Product)
.use revision;

// CASO 11 (Guia P2): SET multiple sobre la relacion y los dos nodos
MATCH (u:Student {id: "4-666-000"})-[r:attends]->(c:Course {nrc: "50691"})
SET r.grade = 9.5, u.activo = true, c.cupo = 30
RETURN u.id, r.grade;

MATCH (u:Student {id: "4-666-000"})-[r:attends]->(c:Course)
RETURN u.activo, r.grade, c.nrc, c.cupo;

// CASO 12 (Guia P2): REMOVE multiple, dos propiedades y una etiqueta
MATCH (p:Product {code: "PROD-99"})
REMOVE p.discount, p.promo, p:Oferta
RETURN p.id;

// Ya no hay productos con la etiqueta Oferta (0 filas); PROD-99 conserva su nombre
MATCH (p:Product:Oferta)
RETURN p.id;

MATCH (p:Product {code: "PROD-99"})
RETURN p.id, p.name;

.use revision;
